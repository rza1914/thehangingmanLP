# Telegram bot token (get from @BotFather)
# Required in production; leave empty for mock mode locally
BOT_TOKEN=

# Telegram chat ID to receive messages (user or group)
# Required in production; leave empty for mock mode locally
CHAT_ID=

# Comma-separated list of allowed CORS origins
# In development, use "/*" or "allow-all" for wildcard
ALLOWED_ORIGINS=http://localhost:5173

# Environment: development or production
# Controls CORS wildcard behavior and production guard
ENVIRONMENT=development